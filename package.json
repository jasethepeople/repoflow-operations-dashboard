{
  "name": "repoflow-operations-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test",
    "preview": "vite preview --host 0.0.0.0",
    "start": "bun run server.ts",
    "build:dashboard-data": "bun scripts/build-dashboard-data.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
